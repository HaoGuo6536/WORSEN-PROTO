.debug-overlay {
    position: absolute;
    flex-direction: column;
    padding: 12px 16px;
    background-color: rgba(12, 19, 23, 0.94);
    border-left-width: 3px;
    border-left-color: rgb(101, 224, 202);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    color: rgb(230, 239, 241);
}

.debug-title {
    -unity-font-style: bold;
    color: rgb(101, 224, 202);
    margin-bottom: 2px;
}

.debug-caption {
    color: rgb(154, 178, 183);
    margin-bottom: 10px;
}

.debug-line {
    margin-bottom: 4px;
    white-space: normal;
}
